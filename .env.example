# Copy to .env and fill in. .env is gitignored.

# Anthropic credentials.
# Leave ANTHROPIC_API_KEY unset if you have run `ant auth login` — the SDK
# resolves the stored OAuth profile automatically with a zero-arg client.
# Note: a set-but-empty ANTHROPIC_API_KEY still wins over a profile and will
# authenticate with an empty key. Unset it rather than blanking it.
ANTHROPIC_API_KEY=

# Review engine. Pinned deliberately: the model ID is part of a run's identity,
# because "the same document reviewed twice produces aligned results" is a
# customer requirement. Changing this invalidates prior runs' comparability.
REGREVIEW_MODEL=claude-opus-4-8
REGREVIEW_EFFORT=high

# Where uploaded records and SOPs are stored on local disk. Only extracted
# text leaves this machine; the original files never do.
REGREVIEW_UPLOAD_DIR=./data/uploads

# Cache for downloaded public regulatory sources (FDA xlsx, eCFR XML, guidance
# PDFs). Safe to delete; re-fetched by the ingest CLIs.
REGREVIEW_CORPUS_CACHE=./corpus-cache

# Server
HOST=127.0.0.1
PORT=8787

# Reviewer accounts and sessions. Leave unset for local dev on 127.0.0.1 — the
# server refuses to bind to anything else without this set. Create an account
# with `npm run user:create -- <username> <password>` once this is set.
MONGODB_URI=
MONGODB_DB=regreview

# Origin(s) allowed to call this API with credentials (comma-separated). The
# site (apps/web) is always a different origin from this API now, so this must
# match exactly where it's served from — scheme, host, and port.
REGREVIEW_SITE_ORIGIN=http://localhost:5174

# Rate limit on non-login requests, per minute.
REGREVIEW_RATE_LIMIT=120

# Hourly cap on documents sent to the model per reviewer account. A single
# batch review counts once per document in it, not once per request.
REGREVIEW_HOURLY_REVIEW_LIMIT=20

# Bearer password for POST /api/admin/reset-limit, which clears a reviewer's
# hourly count for testing/demos. Leave unset to disable the endpoint (it
# 404s) — there is no default, since an admin endpoint with no password
# configured is an open door.
REGREVIEW_ADMIN_PASSWORD=

# Neon Postgres — regulatory corpus (21 CFR text, FDA observations, and the
# public/authored rule set). No customer content ever lands here.
NEON_DATABASE_URL=

# Neon Postgres — customer content: uploaded records, extracted blocks/facts,
# and every run/finding derived from them (findings embed verbatim quotes
# from the uploaded document). Kept separate from the corpus DB above.
NEON_CUSTOMER_DATABASE_URL=

# Neon Postgres — uploaded SOPs and the rules derived from them. Kept out of
# both the corpus DB (not public regulation) and the customer DB (a separate
# concern from records/runs/findings).
NEON_SOPS_DATABASE_URL=

# Neon Postgres — frozen archive of the pre-migration data/regreview.db
# SQLite file, original unsplit schema. Not read by the running app; only
# used once by the one-off archive script.
NEON_OLD_DATABASE_URL=
