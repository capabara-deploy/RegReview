# Copy to .env and fill in. .env is gitignored.

# Anthropic credentials.
# Leave ANTHROPIC_API_KEY unset if you have run `ant auth login` — the SDK
# resolves the stored OAuth profile automatically with a zero-arg client.
# Note: a set-but-empty ANTHROPIC_API_KEY still wins over a profile and will
# authenticate with an empty key. Unset it rather than blanking it.
ANTHROPIC_API_KEY=

# Review engine. Pinned deliberately: the model ID is part of a run's identity,
# because "the same document reviewed twice produces aligned results" is a
# customer requirement. Changing this invalidates prior runs' comparability.
REGREVIEW_MODEL=claude-opus-4-8
REGREVIEW_EFFORT=high

# Where the SQLite database lives.
REGREVIEW_DB=./data/regreview.db

# Where uploaded records and SOPs are stored on local disk. Only extracted
# text leaves this machine; the original files never do.
REGREVIEW_UPLOAD_DIR=./data/uploads

# Cache for downloaded public regulatory sources (FDA xlsx, eCFR XML, guidance
# PDFs). Safe to delete; re-fetched by the ingest CLIs.
REGREVIEW_CORPUS_CACHE=./corpus-cache

# Server
PORT=8787
